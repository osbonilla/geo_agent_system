# ══════════════════════════════════════════════════════════
#  GeoAgent System — copiá este archivo a .env y completalo
# ══════════════════════════════════════════════════════════

# ── LLM ───────────────────────────────────────────────────
# Formato: LLM_MODEL=<proveedor>/<modelo>
#
# Objetivo de la tesis: SLM (≈1-8B parámetros). Los modelos grandes quedan
# como LÍNEA BASE para comparar en la evaluación (eval/run_eval.py).
#
# El modelo DEBE soportar tool calling. En Ollama son los que muestran la
# etiqueta "tools" en ollama.com/library.
#
#   ── SLM locales (Ollama) ──────────────────────────────
#   ollama/qwen2.5:7b          ← SLM recomendado para empezar
#   ollama/qwen2.5:3b
#   ollama/llama3.2:3b
#   ollama/llama3.1:8b
#   ollama/qwen3:4b            (verificá en ollama.com qué versiones hay vigentes)
#
#   ── Línea base (LLM grande, para comparar) ───────────
#   nvidia_nim/openai/gpt-oss-20b
#   nvidia_nim/meta/llama-3.3-70b-instruct
#   groq/llama-3.3-70b-versatile
#   openai/gpt-4o-mini
#
#   auto   ← prueba en orden: ollama, nvidia_nim, groq, vpn, openai
LLM_MODEL=nvidia_nim/openai/gpt-oss-20b

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# ── NVIDIA NIM ────────────────────────────────────────────
# Key gratuita en https://build.nvidia.com (Get API Key)
NVIDIA_NIM_API_KEY=nvapi-...
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Ollama (LLM local) ────────────────────────────────────
# Sin Docker (uvicorn en tu máquina):
OLLAMA_BASE_URL=http://localhost:11434
# Con Docker, el contenedor de la API usa esta otra (host.docker.internal = tu PC).
# Con el perfil local-llm: http://ollama:11434
OLLAMA_DOCKER_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
# Ventana de contexto. Sin esto Ollama usa 2048-4096 y recorta el prompt en silencio.
OLLAMA_NUM_CTX=8192
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Groq ──────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── API remota vía VPN (OpenAI-compatible) ────────────────
VPN_API_BASE_URL=
VPN_API_KEY=
VPN_MODEL=gpt-4o-mini

# ── Embeddings para vectorizar WebMaps ────────────────────
#   auto        → Ollama (si hiciste `ollama pull nomic-embed-text`) y si no, local
#   local       → MiniLM dentro del contenedor, sin API key (descarga ~80 MB la 1ª vez)
#   ollama      → OLLAMA_EMBED_MODEL
#   nvidia_nim  → EMBEDDING_MODEL por API (requiere NVIDIA_NIM_API_KEY)
# Cambiar de proveedor obliga a re-vectorizar: los índices se regeneran solos.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2

# ── ChromaDB ──────────────────────────────────────────────
# CHROMA_HOST vacío = índice en disco (CHROMA_PATH)
# En docker-compose se setea CHROMA_HOST=chroma
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_PATH=./chroma_data
CHROMA_PREFIX=webmap
CHROMA_CATALOG=webmaps_catalog
CHROMA_LAYERS=webmap_layers
# WebMaps que no se listan ni se vectorizan (Survey123 crea uno con cada formulario)
WEBMAPS_EXCLUDE_TAGS=Survey123

# ── Diseño para SLM ───────────────────────────────────────
# Grounding: cuántas capas candidatas del índice se le dan al agente
GROUNDING_K=4
GROUNDING_MIN_SIM=0.25
# Iteraciones máximas de herramientas por agente
AGENT_MAX_ITERATIONS=6

# ── ArcGIS Online ─────────────────────────────────────────
ARCGIS_URL=https://www.arcgis.com
ARCGIS_USERNAME=tu_usuario
ARCGIS_PASSWORD=tu_password

# ── PostgreSQL ────────────────────────────────────────────
# En docker-compose: DB_HOST=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geo_agents_db
DB_USER=postgres
DB_PASSWORD=postgres

# ── App ───────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000

# ── Frontend ──────────────────────────────────────────────
# El servidor Bun proxea /api hacia acá
API_URL=http://localhost:8000
FRONTEND_PORT=5173
ARCGIS_JS_VERSION=4.34
